    <key>LSRequiresIPhoneOS</key><true/>
    <key>CFBundleURLTypes</key><array><dict><key>CFBundleURLName</key><string>local.suixing.pocket</string><key>CFBundleURLSchemes</key><array><string>suixing</string></array></dict></array>
